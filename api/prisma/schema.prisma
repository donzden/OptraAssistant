generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  INACTIVE
}

enum RiskAppetite {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  passwordHash         String
  phone                String?
  avatarUrl            String?
  role                 UserRole      @default(USER)
  status               UserStatus    @default(PENDING)
  emailVerified        Boolean       @default(false)
  phoneVerified        Boolean       @default(false)
  riskAppetite         RiskAppetite  @default(MODERATE)
  preferredInstruments String[]      @default(["NIFTY", "BANKNIFTY"])
  defaultLotSize       Int           @default(1)
  loginFailureCount    Int           @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  refreshTokens    RefreshToken[]
  otpTokens        OtpToken[]
  auditLogs        AuditLog[]
  positions        Position[]
  kiteOAuthToken   KiteOAuthToken?
  favourites       UserStrategyFavourite[]
  userStrategies   UserStrategy[]
  watchlistItems   WatchlistItem[]

  @@index([email])
  @@map("users")
}


model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("refresh_tokens")
}

model OtpToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // EMAIL_VERIFY | PHONE_VERIFY | PASSWORD_RESET
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@map("otp_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // LOGIN | LOGOUT | REGISTER | PASSWORD_CHANGE | PASSWORD_RESET
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

enum PositionType {
  LONG
  SHORT
}

enum OptionType {
  CE
  PE
}

model Position {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol        String       // NIFTY, BANKNIFTY, etc.
  instrumentKey String?      // Upstox instrument key for live price lookup
  strike        Float
  expiry        String       // YYYY-MM-DD
  optionType    OptionType
  positionType  PositionType
  lots          Int
  lotSize       Int          @default(50)
  avgPrice      Float
  currentPrice  Float?
  source        String       @default("MANUAL") // MANUAL | UPSTOX_IMPORT
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@map("positions")
}

model KiteOAuthToken {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  // Kite tokens expire at 6 AM IST next day — no refresh token; user re-auths daily
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("kite_oauth_tokens")
}

enum StrategyCategory {
  DIRECTIONAL
  NON_DIRECTIONAL
  VOLATILITY
}

enum StrategyType {
  DEBIT
  CREDIT
  VARIES
}

enum IVLevel {
  LOW
  LOW_NORMAL
  NORMAL
  HIGH_NORMAL
  HIGH
}

enum RiskLevel {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

model Strategy {
  id          String           @id @default(uuid())
  name        String           @unique
  category    StrategyCategory
  type        StrategyType
  description String
  outlook     String[]
  ivLevels    IVLevel[]
  dteMin      Int?
  dteMax      Int?
  riskLevel   RiskLevel
  legs        Json
  conditions  Json
  rules       Json
  source      String           @default("EXCEL")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  favourites     UserStrategyFavourite[]
  watchlistItems WatchlistItem[]

  @@map("strategies")
}

model UserStrategy {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  category         StrategyCategory @default(NON_DIRECTIONAL)
  type             StrategyType     @default(VARIES)
  riskLevel        RiskLevel        @default(MODERATE)
  outlook          String[]         @default([])
  ivLevels         IVLevel[]        @default([])
  legs             Json
  notes            String?
  tags             String[]         @default([])
  isTemplate       Boolean          @default(false)
  sourceStrategyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_strategies")
}

model WatchlistItem {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId     String
  strategy       Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  notes          String?
  alertThreshold Float    @default(75)
  alertEnabled   Boolean  @default(false)
  lastMatchPct   Float?
  lastCheckedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, strategyId])
  @@map("watchlist_items")
}

model UserStrategyFavourite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, strategyId])
  @@map("user_strategy_favourites")
}
