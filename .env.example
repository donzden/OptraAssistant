# ─── Node API (api/.env) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://optra:optra@localhost:5432/optra
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# SMTP (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="OptraAssistant <no-reply@optraassistant.com>"

# ─── Python Engine (engine/.env) ──────────────────────────────────────────────
DATABASE_URL=postgresql://optra:optra@localhost:5432/optra
REDIS_URL=redis://localhost:6379/0
INTERNAL_API_KEY=change-me-internal-key
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ANTHROPIC_API_KEY=sk-ant-...
DEBUG=false

# ─── Frontend (frontend/.env) ─────────────────────────────────────────────────
# No secrets in frontend env — all public vars must be prefixed VITE_
# VITE_API_URL is auto-proxied via vite.config.ts in dev
